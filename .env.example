# SITE_URL: the public production URL (e.g. https://exotictintqatar.com).
# Used for canonical URLs, Open Graph URLs, sitemap.xml, robots.txt and structured data.
# Read at BUILD time (pages are statically generated). Takes precedence over APP_URL.
SITE_URL="https://exotictintqatar.com"

# SEO_NOINDEX: set to "true" on staging/preview builds. robots.txt then disallows everything
# and every page sends <meta name="robots" content="noindex, nofollow">. Leave unset in production.
# SEO_NOINDEX="true"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Only used as a fallback when SITE_URL is not set.
APP_URL="MY_APP_URL"
